{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.38.0",
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@sveltejs/adapter-auto": "catalog:sveltejs",
    "@sveltejs/kit": "catalog:sveltejs",
    "@sveltejs/vite-plugin-svelte": "catalog:sveltejs",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "eslint": "10.8.1",
    "prettier-plugin-svelte": "catalog:sveltejs",
    "shadcn-svelte": "^1.5.1",
    "svelte": "catalog:sveltejs",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-svelte": "3.0.0"
  }
}
